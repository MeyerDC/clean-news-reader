<?xml version="1.0" encoding="utf-8"?>
<!-- FR-3: resizable headline list with a header that shows last-refresh time
     and doubles as a manual refresh button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:background="@drawable/widget_row_background">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_widget_logo"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Set in the system sans, not the app's display serif.
                 android:fontFamily="@font/..." compiles and resolves correctly
                 here, but the launcher inflates this layout in its own process
                 and will not load a font resource across that boundary — the
                 text silently falls back. The mark above carries the identity
                 instead. See README, "Identity". -->
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

        <!-- Padded well beyond the icon: it sits inside the header, which now
             opens the app, so a near-miss must still land on refresh rather
             than launching the reader. A child's click target wins over its
             parent's, but only where the child actually is. -->
        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>

    <!-- FrameLayout, not View: RemoteViews will only inflate classes annotated
         @RemoteView, and android.view.View is not one of them — a plain <View>
         here makes the entire widget fail to inflate in the launcher. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider" />

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/widget_divider"
        android:dividerHeight="1dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_empty"
        android:textSize="13sp"
        android:textColor="@color/widget_text_secondary" />
</LinearLayout>
