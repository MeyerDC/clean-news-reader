<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backup is off deliberately. Spec section 3: no sync, no backend, all
         work happens on device. Auto Backup would upload this app's database —
         the feed list, the full reading history and the Guardian API key — to
         the user's Google Drive, which is the thing that premise rules out.
         data_extraction_rules is the Android 12+ counterpart. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- FR-8: appear in the Android share sheet for shared text and links. -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Some apps share a URL with an explicit link mime type. -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/x-uri" />
            </intent-filter>

            <!-- Offer this app when a link from a followed publisher is tapped
                 elsewhere. Scoped to these domains on purpose: a filter for all
                 of https would put this app in the chooser for every link on the
                 phone, which is a browser's job, not a reader's.

                 These can never be *verified* App Links — that needs an
                 assetlinks.json served from each publisher's own domain, and
                 they are not ours. So on Android 12+ the app is listed but
                 dormant until "Open supported links" is switched on for it in
                 Settings; the share sheet remains the route that always works.

                 The list is static, so a feed added later is not covered. -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="dailymaverick.co.za" />
                <data android:host="*.dailymaverick.co.za" />
                <data android:host="groundup.org.za" />
                <data android:host="*.groundup.org.za" />
                <data android:host="mybroadband.co.za" />
                <data android:host="*.mybroadband.co.za" />
                <data android:host="businesstech.co.za" />
                <data android:host="*.businesstech.co.za" />
                <data android:host="iol.co.za" />
                <data android:host="*.iol.co.za" />
                <data android:host="timeslive.co.za" />
                <data android:host="*.timeslive.co.za" />
                <data android:host="theguardian.com" />
                <data android:host="*.theguardian.com" />
                <data android:host="ewn.co.za" />
                <data android:host="*.ewn.co.za" />
            </intent-filter>

            <!-- FR-3: widget rows launch straight into the reader view. -->
            <intent-filter>
                <action android:name="com.dmeyer.cleannews.OPEN_ARTICLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- FR-3: home-screen headline widget. Runs in the widget host process
             and reads the shared SQLite database directly (spec 4.1). -->
        <receiver
            android:name=".widget.HeadlinesWidgetProvider"
            android:label="@string/widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- An app update cancels our PendingIntents; this lets the
                     widget hand the launcher working ones straight away. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/headlines_widget_info" />
        </receiver>

        <service
            android:name=".widget.HeadlinesRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the polling job survive a reboot so the widget keeps updating. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <!-- Needed to resolve a Custom Tabs capable browser for FR-7. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
